datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // bcrypt hash (cost 12)
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model ServiceRequest {
  id           String   @id @default(cuid())
  companyName  String
  contactName  String
  position     String?
  phone        String
  email        String
  serviceType  String // 'ULO' | 'Tier One' | 'Intermix' | 'Supermix'
  capacity     Int
  capacityUnit String // 'Mbps' | 'Gbps'
  ipAddress    String?
  notes        String?
  status       String   @default("BARU") // 'BARU' | 'DIPROSES' | 'SELESAI' | 'DITOLAK'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String // 'STATUS_CHANGE' | 'DELETE'
  targetId  String
  detail    String?
  createdAt DateTime @default(now())
}

model Service {
  id           String   @id @default(cuid())
  name         String   @unique
  subtitle     String?
  description  String?
  imagePreview String? // preview — tampil di kartu layanan (publik)
  imageFull    String? // gambar full — tampil di panel kanan (publik); fallback ke preview bila kosong
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSetting {
  id               String   @id @default("singleton")
  aboutTitle       String
  aboutDescription String
  aboutImage       String? // opsional; bila kosong pakai preview layanan pertama
  aboutBullets     String // newline-separated
  brandName        String   @default("eQuotation")
  brandSubtitle    String   @default("Service Request")
  brandLogo        String? // path gambar di public/images/services; kosong = ikon default
  updatedAt        DateTime @updatedAt
}
