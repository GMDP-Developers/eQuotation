# Salin ke .env — atau biarkan `npm run setup` yang buat otomatis (recommended).
# Generate secret: openssl rand -base64 32   (atau: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# JANGAN menaruh teks placeholder apa pun di nilai secret — tulis hasil command-nya.

DATABASE_URL="file:./prod.db"
NEXTAUTH_SECRET="<isi-dengan-random-base64-32-byte>"
AUTH_SECRET="<isi-dengan-random-base64-32-byte>" # Auth.js v5; boleh sama dengan NEXTAUTH_SECRET
AUTH_TRUST_HOST=true
SEED_ADMIN_PASSWORD="admin123" # ganti di production publik
# Opsional (dev LAN saja): ALLOWED_DEV_ORIGINS="10.202.10.15,IP_PUBLIK_ANDA"
